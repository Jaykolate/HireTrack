<h1>Edit application</h1>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="form-errors">
    <% errors.forEach(err => { %>
      <p class="form-error"><%= err %></p>
    <% }) %>
  </div>
<% } %>

<%
  // Use formData if re-rendering after validation failure, otherwise use the DB record
  var fd = (typeof formData !== 'undefined') ? formData : application;
  var dateVal = '';
  if (fd.applied_date) {
    dateVal = (fd.applied_date instanceof Date) ? fd.applied_date.toISOString().split('T')[0] : fd.applied_date;
  }
%>

<form action="/applications/<%= application.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="app-form">
  <label for="company_name">Company name</label>
  <input type="text" id="company_name" name="company_name" value="<%= fd.company_name %>" required>

  <label for="role_title">Role</label>
  <input type="text" id="role_title" name="role_title" value="<%= fd.role_title %>" required>

  <label for="status">Status</label>
  <select id="status" name="status" required>
    <% ['Applied', 'Interview', 'Offer', 'Rejected'].forEach(s => { %>
      <option value="<%= s %>" <%= fd.status === s ? 'selected' : '' %>><%= s %></option>
    <% }) %>
  </select>

  <label for="applied_date">Applied date</label>
  <input type="date" id="applied_date" name="applied_date" value="<%= dateVal %>" required>

  <label for="notes">Notes</label>
  <textarea id="notes" name="notes" rows="3"><%= fd.notes || '' %></textarea>

  <!-- Resume section -->
  <label>Resume (PDF, optional)</label>

  <% if (application.resume_file_url) { %>
    <div class="current-resume">
      <div class="current-resume-info">
        <span class="current-resume-icon">📎</span>
        <span class="current-resume-name"><%= application.resume_file_name %></span>
        <a href="<%= application.resume_file_url %>" target="_blank" class="resume-link">View</a>
      </div>
      <label class="remove-resume-label">
        <input type="checkbox" name="remove_resume" id="remove_resume">
        Remove current resume
      </label>
    </div>
  <% } %>

  <div class="file-upload-zone" id="upload-zone">
    <div class="file-upload-content">
      <div class="file-upload-icon">📄</div>
      <p class="file-upload-text"><%= application.resume_file_url ? 'Replace resume — drag & drop or' : 'Drag & drop your resume here or' %> <span class="file-upload-link">browse files</span></p>
      <p class="file-upload-hint">PDF only · Max 5 MB</p>
    </div>
    <input type="file" id="resume" name="resume" accept=".pdf,application/pdf" class="file-upload-input">
  </div>
  <div class="file-preview" id="file-preview" style="display:none;">
    <span class="file-preview-icon">📎</span>
    <span class="file-preview-name" id="file-name"></span>
    <button type="button" class="file-preview-remove" id="file-remove" title="Remove file">✕</button>
  </div>

  <button type="submit" class="btn">Update application</button>
</form>

<script>
  (function() {
    var zone = document.getElementById('upload-zone');
    var input = document.getElementById('resume');
    var preview = document.getElementById('file-preview');
    var nameEl = document.getElementById('file-name');
    var removeBtn = document.getElementById('file-remove');

    zone.addEventListener('click', function() { input.click(); });

    zone.addEventListener('dragover', function(e) {
      e.preventDefault();
      zone.classList.add('drag-over');
    });
    zone.addEventListener('dragleave', function() {
      zone.classList.remove('drag-over');
    });
    zone.addEventListener('drop', function(e) {
      e.preventDefault();
      zone.classList.remove('drag-over');
      if (e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        showPreview(e.dataTransfer.files[0]);
      }
    });

    input.addEventListener('change', function() {
      if (input.files.length) showPreview(input.files[0]);
    });

    function showPreview(file) {
      nameEl.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
      zone.style.display = 'none';
      preview.style.display = 'flex';
    }

    removeBtn.addEventListener('click', function() {
      input.value = '';
      zone.style.display = '';
      preview.style.display = 'none';
    });
  })();
</script>