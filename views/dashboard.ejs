<h1>Dashboard</h1>

<div class="stats-grid">
  <div class="stat-card stat-total">
    <div>
      <p class="stat-label">Total applications</p>
      <p class="stat-value"><%= total %></p>
    </div>
  </div>
  <div class="stat-card stat-applied">
    <div>
      <p class="stat-label">Applied</p>
      <p class="stat-value"><%= stats.Applied %></p>
    </div>
  </div>
  <div class="stat-card stat-interview">
    <div>
      <p class="stat-label">Interview</p>
      <p class="stat-value"><%= stats.Interview %></p>
    </div>
  </div>
  <div class="stat-card stat-offer">
    <div>
      <p class="stat-label">Offers</p>
      <p class="stat-value"><%= stats.Offer %></p>
    </div>
  </div>
  <div class="stat-card stat-rejected">
    <div>
      <p class="stat-label">Rejected</p>
      <p class="stat-value"><%= stats.Rejected %></p>
    </div>
  </div>
</div>

<% if (applications.length > 0) { %>
<div class="analytics-section">
  <div class="chart-card">
    <h3 class="chart-title">Status Breakdown</h3>
    <div class="chart-wrapper">
      <canvas id="statusChart"></canvas>
    </div>
  </div>
  <div class="chart-card">
    <h3 class="chart-title">Applications Over Time</h3>
    <div class="chart-wrapper">
      <canvas id="timelineChart"></canvas>
    </div>
  </div>
</div>
<% } %>


<div class="table-header">
  <h2>Applications</h2>
  <% if (typeof userName !== 'undefined' && userName) { %>
    <a href="/applications/new" class="btn">+ Add new</a>
  <% } else { %>
    <button type="button" class="btn" onclick="showLoginWarning()">+ Add new</button>
  <% } %>
</div>

<% if (applications.length === 0) { %>
  <div class="empty-state">
    <p class="empty-state-title">No applications yet</p>
    <% if (typeof userName !== 'undefined' && userName) { %>
      <p class="empty-state-text">Start tracking your job search by adding your first application.</p>
      <a href="/applications/new" class="btn">+ Add your first application</a>
    <% } else { %>
      <p class="empty-state-text">Sign in to start tracking your job applications.</p>
      <button type="button" class="btn" onclick="showLoginWarning()">+ Add your first application</button>
    <% } %>
  </div>
<% } else { %>
<table class="app-table">
  <thead>
    <tr>
      <th>Company</th>
      <th>Role</th>
      <th>Applied date</th>
      <th>Status</th>
      <th>Resume Version</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% applications.forEach(app => { %>
      <tr>
        <td data-label="Company"><%= app.company_name %></td>
        <td data-label="Role"><%= app.role_title %></td>
        <td data-label="Date"><%= new Date(app.applied_date).toLocaleDateString() %></td>
        <td data-label="Status"><span class="badge badge-<%= app.status.toLowerCase() %>"><%= app.status %></span></td>
        <td data-label="Resume Version">
          <% if (app.resume_title) { %>
            <a href="<%= app.resume_path %>" target="_blank" class="resume-version-badge" title="View/Download <%= app.resume_title %> (<%= app.resume_version %>)">
              📎 <%= app.resume_title %> <span class="v-pill"><%= app.resume_version %></span>
            </a>
          <% } else if (app.resume_file_url) { %>
            <a href="<%= app.resume_file_url %>" target="_blank" class="resume-indicator" title="View legacy resume">PDF</a>
          <% } else { %>
            <span class="resume-none">—</span>
          <% } %>
        </td>
        <td class="actions">
          <a href="/applications/<%= app.id %>/details">View</a>
          <a href="/applications/<%= app.id %>">Edit</a>
          <form action="/applications/<%= app.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this application?')">
            <button type="submit" class="link-btn">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<!-- Login Warning Modal -->
<div class="login-modal-overlay" id="loginModal">
  <div class="login-modal">
    <button class="login-modal-close" id="closeLoginModal" title="Close">&times;</button>
    <h3 class="login-modal-title">Login Required</h3>
    <p class="login-modal-text">Please sign in before you can create or manage job applications.</p>
    <div class="login-modal-actions">
      <a href="/sign-in" class="btn login-modal-btn-primary">Sign in</a>
      <a href="/sign-up" class="btn btn-outline login-modal-btn-secondary">Create account</a>
    </div>
  </div>
</div>

<script>
  function showLoginWarning() {
    var modal = document.getElementById('loginModal');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function hideLoginWarning() {
    var modal = document.getElementById('loginModal');
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  document.getElementById('closeLoginModal').addEventListener('click', hideLoginWarning);
  document.getElementById('loginModal').addEventListener('click', function(e) {
    if (e.target === this) hideLoginWarning();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideLoginWarning();
  });
</script>

<% if (applications.length > 0) { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function() {
    const stats = <%- JSON.stringify(stats) %>;
    const timelineData = <%- JSON.stringify(timeline) %>;

    if (document.getElementById('statusChart')) {
      const ctxStatus = document.getElementById('statusChart').getContext('2d');
      new Chart(ctxStatus, {
        type: 'doughnut',
        data: {
          labels: ['Applied', 'Interview', 'Offer', 'Rejected'],
          datasets: [{
            data: [stats.Applied, stats.Interview, stats.Offer, stats.Rejected],
            backgroundColor: ['#9ca3af', '#3b82f6', '#10b981', '#ef4444'],
            borderWidth: 1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                boxWidth: 12,
                font: {
                  size: 12
                }
              }
            }
          }
        }
      });
    }

    if (document.getElementById('timelineChart')) {
      const ctxTimeline = document.getElementById('timelineChart').getContext('2d');
      const labels = timelineData.map(item => {
        const parts = item.month.split('-');
        const year = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10);
        const date = new Date(year, month - 1);
        return date.toLocaleDateString(undefined, { month: 'short', year: 'numeric' });
      });
      const counts = timelineData.map(item => item.count);

      new Chart(ctxTimeline, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Applications',
            data: counts,
            backgroundColor: '#2563eb',
            borderRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                stepSize: 1
              },
              grid: {
                color: '#e5e7eb'
              }
            },
            x: {
              grid: {
                display: false
              }
            }
          },
          plugins: {
            legend: {
              display: false
            }
          }
        }
      });
    }
  })();
</script>
<% } %>