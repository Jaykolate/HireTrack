<h1>Add new application</h1>

<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="form-errors">
    <% errors.forEach(err => { %>
      <p class="form-error"><%= err %></p>
    <% }) %>
  </div>
<% } %>

<form action="/applications" method="POST" class="app-form">
  <div class="form-group">
    <label for="company_name">Company name <span class="required">*</span></label>
    <input type="text" id="company_name" name="company_name" value="<%= typeof formData !== 'undefined' ? formData.company_name || '' : '' %>" required maxLength="100">
  </div>

  <div class="form-group">
    <label for="role_title">Role <span class="required">*</span></label>
    <input type="text" id="role_title" name="role_title" value="<%= typeof formData !== 'undefined' ? formData.role_title || '' : '' %>" required maxLength="100">
  </div>

  <div class="form-group">
    <label for="status">Status <span class="required">*</span></label>
    <select id="status" name="status" required>
      <% ['Applied', 'Interview', 'Offer', 'Rejected'].forEach(s => { %>
        <option value="<%= s %>" <%= (typeof formData !== 'undefined' && formData.status === s) ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label for="applied_date">Applied date <span class="required">*</span></label>
    <input type="date" id="applied_date" name="applied_date" value="<%= typeof formData !== 'undefined' ? formData.applied_date || '' : '' %>" required>
  </div>

  <div class="form-group">
    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="3"><%= typeof formData !== 'undefined' ? formData.notes || '' : '' %></textarea>
  </div>

  <!-- Resume Version Selection -->
  <div class="form-group">
    <label for="resume_id">Select Resume Version</label>
    <div class="resume-select-container">
      <select id="resume_id" name="resume_id" class="form-control">
        <option value="">-- Select a Resume Version (Optional) --</option>
        <% if (typeof resumes !== 'undefined' && resumes.length > 0) { %>
          <% resumes.forEach(r => { %>
            <option value="<%= r.id %>" <%= (typeof formData !== 'undefined' && String(formData.resume_id) === String(r.id)) ? 'selected' : '' %>>
              <%= r.title %> (<%= r.version %>)
            </option>
          <% }) %>
        <% } %>
      </select>
      <button type="button" class="btn btn-secondary-outline margin-top-sm" onclick="openInlineModal()">
        + Upload New Resume
      </button>
    </div>
  </div>

  <button type="submit" class="btn btn-primary margin-top">Save application</button>
</form>

<!-- Inline Upload Resume Modal -->
<div id="inlineUploadModal" class="modal-backdrop" style="display:none;">
  <div class="modal-card">
    <div class="modal-header">
      <h3>Upload New Resume Version</h3>
      <button class="close-btn" onclick="closeInlineModal()">&times;</button>
    </div>
    <form id="inlineUploadForm" onsubmit="handleInlineUpload(event)">
      <div class="form-group">
        <label for="inlineTitle">Resume Title <span class="required">*</span></label>
        <input type="text" id="inlineTitle" name="title" class="form-control" placeholder="e.g. Backend Resume, Full Stack" required maxLength="100">
      </div>
      <div class="form-group">
        <label for="inlineVersion">Version Tag <span class="required">*</span></label>
        <input type="text" id="inlineVersion" name="version" class="form-control" placeholder="e.g. v1, v2" required maxLength="50">
      </div>
      <div class="form-group">
        <label for="inlineFile">PDF Document <span class="required">*</span> (Max 5MB)</label>
        <input type="file" id="inlineFile" name="pdf" class="form-control" accept="application/pdf" required>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeInlineModal()">Cancel</button>
        <button type="submit" id="inlineSubmitBtn" class="btn btn-primary">Upload & Attach</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openInlineModal() {
    document.getElementById('inlineUploadModal').style.display = 'flex';
  }
  function closeInlineModal() {
    document.getElementById('inlineUploadModal').style.display = 'none';
    document.getElementById('inlineUploadForm').reset();
  }

  async function handleInlineUpload(e) {
    e.preventDefault();
    const btn = document.getElementById('inlineSubmitBtn');
    btn.disabled = true;
    btn.innerText = 'Uploading...';

    const formData = new FormData(e.target);
    try {
      const res = await fetch('/api/resumes', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        showToast(data.error || 'Upload failed', 'error');
      } else {
        showToast('Resume uploaded and added to options!', 'success');
        
        // Append to dropdown and select it
        const select = document.getElementById('resume_id');
        const opt = document.createElement('option');
        opt.value = data.resume.id;
        opt.textContent = `${data.resume.title} (${data.resume.version})`;
        opt.selected = true;
        select.appendChild(opt);

        closeInlineModal();
      }
    } catch (err) {
      showToast('Network error while uploading resume', 'error');
    } finally {
      btn.disabled = false;
      btn.innerText = 'Upload & Attach';
    }
  }
</script>